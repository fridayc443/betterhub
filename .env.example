# Firebase service account values for local Netlify development
# Copy this file to `.env` and replace the placeholders.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
ADMIN_EMAILS=you@example.com,admin@example.com
PROVIDER_BASE_URL=https://api.getyourotp.com
PROVIDER_API_KEY=your-provider-api-key
